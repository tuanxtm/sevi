#include <windows.h>
#include "resource.h"
IDI_APP ICON "Sevi.ico"
IDI_TRAY_VI ICON "tray-v.ico"
IDI_TRAY_EN ICON "tray-e.ico"
1 24 "Sevi.manifest"
IDR_SOUND_VI RCDATA "Sounds/SwitchToVietnamese.wav"
IDR_SOUND_EN RCDATA "Sounds/SwitchToEnglish.wav"
IDR_EMOJI_JSON RCDATA "../../App/Resources/Emoji.json"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,14,0
 PRODUCTVERSION 1,0,14,0
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Tony Dinh"
      VALUE "FileDescription", "Sevi - Vietnamese typing"
      VALUE "FileVersion", SEVI_VERSION
      VALUE "InternalName", "Sevi"
      VALUE "LegalCopyright", "GPL-3.0. Based on OpenKey by Tuyen Mai."
      VALUE "OriginalFilename", "Sevi.exe"
      VALUE "ProductName", "Sevi"
      VALUE "ProductVersion", SEVI_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
