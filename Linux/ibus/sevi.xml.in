<?xml version="1.0" encoding="utf-8"?>
<component>
  <name>org.freedesktop.IBus.Sevi</name>
  <description>Sevi - Vietnamese input with automatic English/Vietnamese switching</description>
  <exec>@CMAKE_INSTALL_FULL_LIBEXECDIR@/ibus-engine-sevi --ibus</exec>
  <version>@SEVI_VERSION@</version>
  <author>Tony Dinh</author>
  <license>GPL-3.0</license>
  <homepage></homepage>
  <textdomain>sevi</textdomain>
  <engines>
    <engine>
      <name>sevi</name>
      <language>vi</language>
      <license>GPL-3.0</license>
      <author>Tony Dinh</author>
      <icon>sevi</icon>
      <layout>default</layout>
      <longname>Sevi</longname>
      <description>Sevi - Smart English/Vietnamese input</description>
      <rank>99</rank>
      <symbol>V</symbol>
      <setup>@CMAKE_INSTALL_FULL_BINDIR@/sevi-settings</setup>
    </engine>
  </engines>
</component>
